# Copy to apps/web/.env.local when you need a value. Never commit real keys.

# Which market-data source to use. "generated" = simulated prices, no key needed.
NEXT_PUBLIC_MARKET_DATA_PROVIDER=generated

# --- Phase 2 (Supabase). Not used yet. ---
# Safe for the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never put in the mobile app:
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 3 (real market data). Not used yet. SERVER ONLY. ---
MARKET_DATA_API_KEY=
MARKET_DATA_WS_URL=
